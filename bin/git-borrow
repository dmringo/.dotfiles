#!/usr/bin/env python3
"""git-borrow: Deduplicate Git (and LFS) objects via managed bare object hubs."""

from __future__ import annotations

import argparse
import ctypes
import functools
import hashlib
import os
import posixpath
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
from contextlib import contextmanager, suppress
from dataclasses import dataclass
from datetime import UTC, datetime
from pathlib import Path
from typing import NoReturn
from urllib.parse import urljoin, urlsplit

SCRIPT_NAME = "git borrow"
BREADCRUMB_FILE = "borrow-origin"
REF_NS = "refs/borrowers"
HOOK_MARKER = "# managed by git-borrow"

IS_WIN = os.name == "nt"
IS_WIN_LIKE = IS_WIN or sys.platform in ("msys", "cygwin")

_TRUE_VALUES = frozenset({"true", "yes", "on", "1", ""})
_PSEUDO_REFS = ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_HEAD", "ORIG_HEAD")
_GIT_ENV_OVERRIDES = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_COMMON_DIR",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_QUARANTINE_PATH",
)
_LFS_ATTR_RE = re.compile(r"(?m)^(?![ \t]*#).*\b(?:filter|diff|merge)=lfs\b")
_BAD_PATH_CHARS_RE = re.compile(r'[<>:"|?*\x00-\x1f]')

for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(newline="\n")


def usage() -> str:
    return f"""usage:
  {SCRIPT_NAME} clone [options] [-b|-B <branch> | --detach] [-o <origin>] <url> [<dir>]
  {SCRIPT_NAME} add [options] [--] <git worktree add args>
  {SCRIPT_NAME} link [options] [-f|--force] [<path>]
  {SCRIPT_NAME} submodule [add] [options] [-b <branch>] [--name <name>] [--] <url|existing-path> [<path>]
  {SCRIPT_NAME} hub [options] [<path>|<url>]      Print (creating if needed) the bare hub
  {SCRIPT_NAME} sync [--hub <hub>] [<hub|path>]   Refresh borrower refs held by a hub
  {SCRIPT_NAME} gc [--hub <hub>] [<hub|path>] [-- <git gc args>]  sync, then git gc in the hub
  {SCRIPT_NAME} forget [-f|--force] [--keep-refs] [--hub <hub>] <borrower-path|id>
  {SCRIPT_NAME} status [-g|--global] [<path>]

Shares Git (and LFS) objects via managed bare object hubs under
"git config borrow.hubBase" (or $XDG_CACHE_HOME/git-borrow, ~/.cache/git-borrow),
keyed deterministically by canonical URL (<hubBase>/<host>/<path>.git):
  - clone:     resolves/creates the bare hub for <url> and creates <dir> as a linked worktree.
  - add:       creates a new linked worktree in the current repository (like git worktree add).
  - link:      borrows a submodule (or standalone repo with --force) from its hub via alternates.
  - submodule: adds a submodule from a URL or primary standalone repo, borrowing from its hub.

Options:
  --hub, --root <path|url>  Use this hub (or URL's hub) to unify multiple remotes on one hub.
  --lfs=<mode>              LFS handling: share (default, via lfs.storage) or none.
  -b, -B, --branch <br>     clone/add/submodule: create or reset branch <br>.
  --detach                  clone/add: detach HEAD in the new worktree.
  --name <name>             submodule: name of the submodule (defaults to path).
  -o, --origin <name>       clone: use <name> instead of 'origin' for the hub remote.
  -r, --recursive           clone/add/link/submodule: recurse into submodules (defaults to submodule.recurse).
  --no-recursive            clone/add/link/submodule: do not recurse into submodules.
  -j, --jobs <n>            Pass --jobs <n> to git submodule update.
  -f, --force               link: allow standalone repo; forget: skip safety check; add/gc/submodule: pass -f.
  --keep-refs               forget: unregister borrower but retain its archived refs in the hub.
  -g, --global              status: show all canonical URL->hub mappings, hubs, remotes, and borrowers.
  -q, --quiet               Less output.
  -h, --help                Show this help."""


# =============================================================================
# 1. Errors, Options & Path / OS Primitives
# =============================================================================


class BorrowError(Exception):
    def __init__(self, message: str, exit_code: int = 1):
        super().__init__(message)
        self.message = message
        self.exit_code = exit_code


def die(msg: str, exit_code: int = 1) -> NoReturn:
    raise BorrowError(msg, exit_code)


def warn(msg: str) -> None:
    sys.stderr.write(f"warning: {msg}\n")


def now_iso() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


@dataclass
class Opts:
    quiet: bool = False
    lfs_mode: str = "share"
    jobs: str | None = None
    explicit_hub: str | None = None
    force: bool = False
    keep_refs: bool = False
    recursive: bool | None = None
    global_status: bool = False

    def note(self, msg: str) -> None:
        if not self.quiet:
            sys.stderr.write(f"{msg}\n")

    def skip_smudge_env(self) -> dict[str, str] | None:
        return None if self.lfs_mode == "none" else {"GIT_LFS_SKIP_SMUDGE": "1"}


@dataclass(frozen=True)
class CheckoutSpec:
    branch: str | None = None
    force_branch: str | None = None
    detach: bool = False

    @property
    def requested_branch(self) -> str | None:
        return self.force_branch or self.branch


def norm_str(p: str | Path) -> str:
    """Normalize ~, MSYS drive prefixes (/c/...), /tmp, drive-letter casing, and slashes."""
    s = str(p).strip()
    if s == "~" or s.startswith(("~/", "~\\")):
        s = f"{Path.home().as_posix()}{s[1:]}"
    if IS_WIN_LIKE and (m := re.match(r"^/([a-zA-Z])(?:/(.*))?$", s)):
        s = f"{m.group(1).upper()}:/{m.group(2) or ''}"
    if IS_WIN and (s == "/tmp" or s.startswith("/tmp/")):
        tmp = Path(tempfile.gettempdir()).as_posix()
        s = tmp if s == "/tmp" else f"{tmp}/{s[5:]}"
    s = s.replace("\\", "/")
    if IS_WIN_LIKE and len(s) >= 2 and s[1] == ":" and s[0].isalpha():
        s = s[0].upper() + s[1:]
    return s


def abs_path(p: str | Path) -> Path:
    s = norm_str(p)
    if not (s.startswith("/") or (len(s) >= 2 and s[1] == ":")):
        s = f"{Path.cwd().as_posix()}/{s}"
    with suppress(OSError, RuntimeError):
        s = Path(s).resolve().as_posix()
        if IS_WIN_LIKE and len(s) >= 2 and s[1] == ":" and s[0].isalpha():
            s = s[0].upper() + s[1:]
    return Path(s)


def same_path(a: str | Path | None, b: str | Path | None) -> bool:
    if not a or not b:
        return False
    sa, sb = abs_path(a).as_posix().rstrip("/"), abs_path(b).as_posix().rstrip("/")
    return (sa.lower() == sb.lower()) if IS_WIN_LIKE else (sa == sb)


def path_under(child: Path, parent: Path) -> str | None:
    p_str = parent.as_posix().rstrip("/") + "/"
    c_str = child.as_posix()
    matches = c_str.lower().startswith(p_str.lower()) if IS_WIN_LIKE else c_str.startswith(p_str)
    return c_str[len(p_str) :] if matches else None


def rel_posix(target: Path, start: Path) -> str:
    try:
        return os.path.relpath(target, start).replace("\\", "/")
    except ValueError as e:
        die(f"cannot compute relative path from {start.as_posix()} to {target.as_posix()}: {e}")


def path_occupied(p: Path) -> bool:
    if not p.exists():
        return False
    if not p.is_dir():
        return True
    try:
        return any(os.scandir(p))
    except OSError as e:
        die(f"cannot inspect path {p.as_posix()}: {e}")


def _make_writable(p: Path | str) -> None:
    if IS_WIN:
        with suppress(OSError):
            ctypes.windll.kernel32.SetFileAttributesW(str(p), 0x80)
            os.chmod(p, stat.S_IWRITE | stat.S_IREAD)


def write_lf(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        _make_writable(path)
    path.write_bytes(content.encode("utf-8"))


def rmtree_force(path: Path) -> None:
    if not path.exists() and not path.is_symlink():
        return
    if path.is_symlink() or not path.is_dir():
        _make_writable(path)
        path.unlink(missing_ok=True)
        return

    def _onexc(_fn, fp, _exc):
        _make_writable(fp)
        p = Path(fp)
        with suppress(OSError):
            p.rmdir() if p.is_dir() and not p.is_symlink() else p.unlink(missing_ok=True)

    if sys.version_info >= (3, 12):
        shutil.rmtree(path, onexc=_onexc)
    else:
        shutil.rmtree(path, onerror=_onexc)


def _prune_empty_parents(start: Path, stop_at: Path) -> None:
    curr = start
    while not same_path(curr, stop_at) and path_under(curr, stop_at) is not None:
        try:
            curr.rmdir()
        except OSError:
            break
        curr = curr.parent


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    if IS_WIN:
        # Never call os.kill(pid, 0) on Windows: signal 0 == CTRL_C_EVENT and blasts the console!
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        handle = kernel32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if handle:
            try:
                code = ctypes.c_ulong()
                return bool(kernel32.GetExitCodeProcess(handle, ctypes.byref(code)) and code.value == 259)
            finally:
                kernel32.CloseHandle(handle)
        if ctypes.get_last_error() == 5:  # ERROR_ACCESS_DENIED => process exists
            return True
        if ps_bin := shutil.which("ps"):
            with suppress(OSError):
                ps = subprocess.run([ps_bin, "-p", str(pid)], capture_output=True, text=True)
                return ps.returncode == 0 and sum(1 for ln in ps.stdout.splitlines() if ln.strip()) > 1
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


# =============================================================================
# 2. Git Execution & Config Snapshots
# =============================================================================


@functools.cache
def find_git_cmd() -> list[str]:
    """Resolve `git` on PATH, supporting shell-script `git` shims on Windows."""
    if not IS_WIN:
        return [shutil.which("git") or "git"]

    def is_wsl_stub(s: str) -> bool:
        n = s.lower().replace("\\", "/")
        return n.endswith("/system32/bash.exe") or "/microsoft/windowsapps/" in n

    dirs = [
        abs_path(e) if e.startswith("/") else Path(e)
        for raw in os.environ.get("PATH", "").split(os.pathsep)
        if (e := raw.strip("\"'"))
    ]
    shell = os.environ.get("SHELL", "")
    bash = (
        shell
        if shell.lower().endswith("bash.exe") and not is_wsl_stub(shell) and Path(shell).is_file()
        else next(
            (bp.as_posix() for d in dirs if (bp := d / "bash.exe").is_file() and not is_wsl_stub(bp.as_posix())),
            None,
        )
    )
    for d in dirs:
        if (script := d / "git").is_file():
            header = b""
            with suppress(OSError):
                header = script.read_bytes()[:2]
            if header == b"MZ":
                return [script.as_posix()]
            if bash:
                return [bash, "-c", 'exec "$@"', "_", script.as_posix()]
        if (exe := d / "git.exe").is_file():
            return [exe.as_posix()]
    return [shutil.which("git") or "git"]


def run_git(
    args: list[str],
    *,
    cwd: Path | None = None,
    input: str | None = None,
    check: bool = False,
    capture: bool = True,
    env: dict[str, str] | None = None,
    strip_repo_env: bool = True,
) -> subprocess.CompletedProcess[str]:
    base_env = os.environ.copy()
    if strip_repo_env:
        for var in _GIT_ENV_OVERRIDES:
            base_env.pop(var, None)
    if env:
        base_env.update(env)

    try:
        res = subprocess.run(
            find_git_cmd() + args,
            cwd=str(cwd) if cwd else None,
            input=input.encode("utf-8") if isinstance(input, str) else input,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            env=base_env,
        )
    except OSError as e:
        die(f"failed to run git ({' '.join(args[:3])}): {e}")

    if res.returncode in (130, 143, 3221225786, -1073741510) or (
        res.returncode is not None and res.returncode < 0
    ):
        sys.exit(130)

    out = res.stdout.decode("utf-8", errors="replace") if res.stdout is not None else ""
    err = res.stderr.decode("utf-8", errors="replace") if res.stderr is not None else ""
    if check and res.returncode != 0:
        detail = err.strip() or out.strip() or f"exit code {res.returncode}"
        die(f"git {' '.join(args[:4])} failed: {detail}", exit_code=res.returncode or 1)
    return subprocess.CompletedProcess(res.args, res.returncode, out, err)


def _canon_key(key: str) -> str:
    """Lowercase section and variable name while preserving subsection case."""
    if "." not in key:
        return key.lower()
    sec, rest = key.split(".", 1)
    if "." not in rest:
        return f"{sec.lower()}.{rest.lower()}"
    sub, var = rest.rsplit(".", 1)
    return f"{sec.lower()}.{sub}.{var.lower()}"


def _parse_bool(value: str | None) -> bool | None:
    return None if value is None else (value.strip().lower() in _TRUE_VALUES)


_CONFIG_CACHE: dict[tuple, dict[str, list[str]]] = {}


def _global_config_file() -> Path:
    if explicit := os.environ.get("GIT_CONFIG_GLOBAL"):
        return abs_path(explicit)
    xdg = Path(norm_str(os.environ["XDG_CONFIG_HOME"])) / "git" / "config" if os.environ.get("XDG_CONFIG_HOME") else None
    home_cfg = Path.home() / ".gitconfig"
    if xdg and xdg.is_file() and not home_cfg.is_file():
        return xdg
    return home_cfg


@dataclass(frozen=True)
class GitConfig:
    """Stamped `git config --list -z` view (global, local, worktree, effective, or file)."""

    cache_id: str
    prefix: tuple[str, ...]
    stamp_files: tuple[Path, ...] = ()
    require_files: bool = False
    common_scope: str | None = None

    @classmethod
    def global_(cls) -> GitConfig:
        return cls("global", ("config", "--global"), (_global_config_file(),))

    @classmethod
    def file(cls, path: Path) -> GitConfig:
        p = abs_path(path)
        return cls(f"file:{p.as_posix()}", ("config", "-f", p.as_posix()), (p,), require_files=True)

    @classmethod
    def local(cls, common: Path) -> GitConfig:
        c = abs_path(common)
        return cls(
            f"local:{c.as_posix()}",
            ("--git-dir", c.as_posix(), "config", "--local"),
            (c / "config",),
            common_scope=c.as_posix(),
        )

    @classmethod
    def worktree(cls, repo_path: Path, gitdir: Path, common: Path) -> GitConfig:
        c, gd = abs_path(common), abs_path(gitdir)
        return cls(
            f"wt:{gd.as_posix()}",
            ("-C", repo_path.as_posix(), "config", "--worktree"),
            (c / "config", gd / "config.worktree"),
            common_scope=c.as_posix(),
        )

    @classmethod
    def repo(cls, repo_path: Path, gitdir: Path, common: Path) -> GitConfig:
        c, gd = abs_path(common), abs_path(gitdir)
        return cls(
            f"repo:{gd.as_posix()}",
            ("-C", repo_path.as_posix(), "config"),
            (c / "config", gd / "config.worktree", _global_config_file()),
            common_scope=c.as_posix(),
        )

    def _key(self) -> tuple | None:
        stamps = []
        for p in self.stamp_files:
            with suppress(OSError):
                st = p.stat()
                stamps.append((p.as_posix(), st.st_mtime_ns, st.st_size))
        if self.require_files and not stamps:
            return None
        return (self.cache_id, self.common_scope, *sorted(stamps))

    def entries(self) -> dict[str, list[str]]:
        if (key := self._key()) is None:
            return {}
        if (cached := _CONFIG_CACHE.get(key)) is not None:
            return cached
        res = run_git([*self.prefix, "--list", "-z"])
        if res.returncode != 0:
            die(f"failed to read git config ({' '.join(self.prefix)}): {res.stderr.strip() or f'exit {res.returncode}'}")
        parsed: dict[str, list[str]] = {}
        for item in res.stdout.split("\0"):
            if item:
                k, _, v = item.partition("\n")
                parsed.setdefault(k, []).append(v)
        self._store(parsed)
        return parsed

    def _store(self, entries: dict[str, list[str]]) -> None:
        self.invalidate()
        if (key := self._key()) is not None:
            _CONFIG_CACHE[key] = entries

    def invalidate(self) -> None:
        is_global = self.cache_id == "global"
        for old in [
            k
            for k in _CONFIG_CACHE
            if k[0] == self.cache_id
            or (self.common_scope and k[1] == self.common_scope)
            or (is_global and str(k[0]).startswith("repo:"))
        ]:
            del _CONFIG_CACHE[old]

    def get(self, key: str) -> str | None:
        vals = self.entries().get(_canon_key(key))
        return vals[-1] if vals else None

    def bool(self, key: str) -> bool | None:
        return _parse_bool(self.get(key))

    def pairs(self, pattern: str) -> list[tuple[str, str]]:
        rx = re.compile(pattern)
        return [(k, v) for k, vs in self.entries().items() if rx.search(k) for v in vs]

    def set(self, key: str, value: str, *, replace_all: bool = True) -> None:
        ckey = _canon_key(key)
        entries = self.entries()
        existing = entries.get(ckey, [])
        if existing == [value] or (not replace_all and existing and existing[-1] == value):
            return
        flags = ["--replace-all"] if replace_all and len(existing) > 1 else []
        res = run_git([*self.prefix, *flags, key, value])
        if res.returncode == 5 and not flags:
            res = run_git([*self.prefix, "--replace-all", key, value])
        if res.returncode != 0:
            die(f"failed to write git config {key}: {res.stderr.strip() or f'exit {res.returncode}'}")
        self.invalidate()

    def unset(self, key: str) -> None:
        res = run_git([*self.prefix, "--unset-all", key])
        if res.returncode not in (0, 5):
            die(f"failed to unset git config {key}: {res.stderr.strip() or f'exit {res.returncode}'}")
        self.invalidate()

    def remove_section(self, section: str) -> None:
        res = run_git([*self.prefix, "--remove-section", section])
        if res.returncode != 0 and "no such section" not in res.stderr.lower():
            die(f"failed to remove git config section {section}: {res.stderr.strip() or f'exit {res.returncode}'}")
        self.invalidate()


# =============================================================================
# 3. Domain Model: RemoteUrl, KVFile & Repo
# =============================================================================


@dataclass(frozen=True)
class RemoteUrl:
    raw: str

    @property
    def is_local(self) -> bool:
        u = self.raw
        if not u or u.startswith(("/", "./", "../", "file://", "~")) or re.match(r"^[A-Za-z]:[\\/]", u):
            return True
        if "://" in u:
            return False
        before = u.split(":", 1)[0]
        return before == u or "/" in before or "\\" in before

    @property
    def host_and_path(self) -> tuple[str, str] | None:
        if self.is_local:
            return None
        if "://" in self.raw:
            parsed = urlsplit(self.raw)
            host = parsed.hostname or ""
            path = parsed.path
        else:
            authority, path = self.raw.split(":", 1)
            host = authority.split("@")[-1]
        path = re.sub(r"\.git$", "", path.strip("/"), flags=re.IGNORECASE).strip("/")
        host = host.strip().replace(":", "_")
        return (host, path) if host and path else None

    @property
    def has_traversal(self) -> bool:
        parts = self.host_and_path
        if not parts:
            return False
        _, path = parts
        return any(s in (".", "..") for s in path.split("/") if s)

    @property
    def canonical(self) -> str | None:
        parts = self.host_and_path
        if not parts:
            return None
        host, path = parts
        segs = [s for s in path.split("/") if s]
        if not segs or any(s in (".", "..") or _BAD_PATH_CHARS_RE.search(s) or "\\" in s for s in (host, *segs)):
            return None
        return f"{host}/{'/'.join(segs)}".lower()

    @property
    def repo_name(self) -> str | None:
        parts = self.host_and_path
        return parts[1].split("/")[-1] if parts else None

    @property
    def fallback_name(self) -> str:
        if self.repo_name:
            return self.repo_name
        local = self.local_path_str
        p = abs_path(local) if local in (".", "..", "") else Path(norm_str(local).rstrip("/"))
        return re.sub(r"\.git$", "", p.name, flags=re.IGNORECASE)

    @property
    def local_path_str(self) -> str:
        if self.raw.startswith("file://"):
            p = urlsplit(self.raw).path
            if IS_WIN_LIKE and re.match(r"^/[A-Za-z]:", p):
                p = p[1:]
            return p
        return self.raw


@dataclass(frozen=True)
class Remote:
    name: str
    url: RemoteUrl


def preferred_remote(remotes: list[Remote]) -> Remote | None:
    return next((r for r in remotes if r.name == "origin"), remotes[0] if remotes else None)


def _resolve_relative_submodule_url(super_repo: Repo, raw_url: str) -> str:
    if not raw_url.startswith(("./", "../")):
        return raw_url
    pref = preferred_remote(super_repo.remotes())
    if not pref:
        die(
            f"cannot resolve relative submodule URL '{raw_url}': "
            f"superproject {super_repo.path.as_posix()} has no non-local remote URL"
        )
    base = pref.url.raw
    if "://" in base:
        joined = urljoin(base.rstrip("/") + "/", raw_url)
        parts = urlsplit(joined)
        return parts._replace(path=posixpath.normpath(parts.path)).geturl()
    if ":" in base:
        host, path = base.split(":", 1)
        norm_p = posixpath.normpath(posixpath.join(path.rstrip("/"), raw_url))
        return f"{host}:{norm_p}"
    die(f"cannot resolve relative submodule URL '{raw_url}' against remote '{base}'")


@dataclass(frozen=True)
class KVFile:
    path: Path

    def read(self) -> dict[str, str]:
        if not self.path.is_file():
            return {}
        out: dict[str, str] = {}
        with suppress(OSError, UnicodeDecodeError):
            for line in self.path.read_text("utf-8").splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    out[k] = v
        return out

    def get(self, key: str) -> str | None:
        return self.read().get(key)

    def write(self, **fields: str) -> None:
        write_lf(self.path, "".join(f"{('from' if k == 'from_' else k)}={v}\n" for k, v in fields.items()))


@dataclass(frozen=True)
class WorktreeInfo:
    path: Path
    head: str | None = None
    branch: str | None = None
    bare: bool = False


@dataclass(frozen=True)
class SubmoduleEntry:
    name: str
    path: str


def _unquote_git_line(s: str) -> str:
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        return s[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    return s


def _find_git_dir(path: Path) -> Path | None:
    dotgit = path / ".git"
    if dotgit.is_dir():
        return dotgit
    if dotgit.is_file():
        with suppress(OSError, UnicodeDecodeError):
            content = dotgit.read_text("utf-8").strip()
            if content.startswith("gitdir:"):
                t = Path(norm_str(content.split(":", 1)[1].strip()))
                resolved = abs_path(t if t.is_absolute() else (path / t))
                if resolved.exists():
                    return resolved
    return path if (path / "HEAD").is_file() and (path / "objects").is_dir() else None


def _resolve_common_dir(gitdir: Path) -> Path:
    if (cf := gitdir / "commondir").is_file():
        with suppress(OSError, UnicodeDecodeError):
            t = Path(norm_str(cf.read_text("utf-8").strip()))
            return abs_path(t if t.is_absolute() else (gitdir / t))
    return gitdir


def _discover_toplevel(path: Path) -> Path | None:
    if not path.exists():
        return None
    curr = path if path.is_dir() else path.parent
    while True:
        if gd := _find_git_dir(curr):
            if (curr / ".git").exists():
                common = _resolve_common_dir(gd)
                if not GitConfig.repo(curr, gd, common).get("core.worktree"):
                    return curr
            res = run_git(["-C", curr.as_posix(), "rev-parse", "--show-toplevel"])
            out = res.stdout.strip() if res.returncode == 0 else ""
            return abs_path(out) if out else curr
        if curr.parent == curr:
            return None
        curr = curr.parent


@dataclass(frozen=True)
class Repo:
    """Unified handle for a bare hub, linked worktree, standalone clone, or submodule."""

    path: Path
    gitdir: Path
    common: Path

    @classmethod
    def open(cls, path: str | Path) -> Repo | None:
        p = abs_path(path)
        if not p.exists() or not (gd := _find_git_dir(p)):
            return None
        return cls(p, gd, _resolve_common_dir(gd))

    @classmethod
    def discover(cls, path: str | Path) -> Repo | None:
        if top := _discover_toplevel(abs_path(path)):
            return cls.open(top)
        return None

    @classmethod
    def is_worktree_path(cls, path: str | Path) -> bool:
        repo = cls.open(path)
        if not repo:
            return False
        if (repo.path / ".git").exists():
            return True
        lines = repo.out("rev-parse", "--is-bare-repository", "--show-toplevel").splitlines()
        return len(lines) > 1 and lines[0] == "false" and bool(lines[1])

    # --- Git execution ---

    def git(
        self,
        *args: str,
        input: str | None = None,
        check: bool = False,
        capture: bool = True,
        env: dict[str, str] | None = None,
        as_gitdir: bool = False,
    ) -> subprocess.CompletedProcess[str]:
        prefix = ["--git-dir", self.common.as_posix()] if as_gitdir else ["-C", self.path.as_posix()]
        return run_git(prefix + list(args), input=input, check=check, capture=capture, env=env)

    def out(self, *args: str, as_gitdir: bool = False) -> str:
        res = self.git(*args, as_gitdir=as_gitdir)
        return res.stdout.strip() if res.returncode == 0 else ""

    def ok(self, *args: str, as_gitdir: bool = False) -> bool:
        return self.git(*args, as_gitdir=as_gitdir).returncode == 0

    # --- Config & identity ---

    @property
    def config(self) -> GitConfig:
        return GitConfig.repo(self.path, self.gitdir, self.common)

    @property
    def local_config(self) -> GitConfig:
        return GitConfig.local(self.common)

    @property
    def target_config(self) -> GitConfig:
        """Write-target config honoring `extensions.worktreeConfig` for per-worktree settings."""
        if not self.is_bare and self.config.bool("extensions.worktreeConfig") is True:
            return GitConfig.worktree(self.path, self.gitdir, self.common)
        return self.local_config

    @property
    def gitmodules(self) -> GitConfig:
        return GitConfig.file(self.path / ".gitmodules")

    @property
    def objects_dir(self) -> Path:
        return self.common / "objects"

    @property
    def pack_dir(self) -> Path:
        return self.common / "objects" / "pack"

    @property
    def alternates_file(self) -> Path:
        return self.common / "objects" / "info" / "alternates"

    @property
    def lfs_dir(self) -> Path:
        return self.common / "lfs"

    @property
    def borrower_id(self) -> str:
        return hashlib.sha1(self.common.as_posix().encode("utf-8")).hexdigest()[:12]

    @property
    def is_bare(self) -> bool:
        return same_path(self.path, self.gitdir) and self.local_config.bool("core.bare") is True

    @property
    def is_primary(self) -> bool:
        return (self.path / ".git").is_dir() and not self.config.get("core.worktree")

    @property
    def is_hub(self) -> bool:
        return self.local_config.bool("borrow.isHub") is True

    @property
    def is_reftable(self) -> bool:
        return self.config.get("extensions.refStorage") == "reftable"

    @property
    def is_shallow(self) -> bool:
        return (self.common / "shallow").is_file()

    @property
    def object_format(self) -> str:
        return (self.config.get("extensions.objectFormat") or "sha1").lower()

    @property
    def is_partial(self) -> bool:
        entries = self.config.entries()
        return "extensions.partialclone" in entries or any(
            _parse_bool(v) is True
            for k, vs in entries.items()
            if re.fullmatch(r"remote\..*\.promisor", k)
            for v in vs
        )

    @property
    def recursion_default(self) -> bool:
        return self.config.bool("submodule.recurse") is True

    def breadcrumb(self, *, in_gitdir: bool = False) -> KVFile:
        return KVFile((self.gitdir if in_gitdir else self.common) / BREADCRUMB_FILE)

    def superproject(self) -> Path | None:
        if self.is_bare:
            return None
        out = self.out("rev-parse", "--show-superproject-working-tree")
        return abs_path(out) if out else None

    def associated_hub(self) -> Repo | None:
        if (common_repo := Repo.open(self.common)) and common_repo.is_hub:
            return common_repo
        if h := self.breadcrumb().get("hub"):
            if (hub := Repo.open(h)) and hub.is_hub:
                return hub
        return None

    # --- Alternates & object size ---

    def alternate_dirs(self) -> list[Path]:
        if not self.alternates_file.is_file():
            return []
        try:
            text = self.alternates_file.read_text("utf-8")
        except (OSError, UnicodeDecodeError) as e:
            die(f"cannot read alternates file {self.alternates_file.as_posix()}: {e}")
        out: list[Path] = []
        for raw_line in text.splitlines():
            s = raw_line.strip()
            if not s or s.startswith("#"):
                continue
            p = Path(norm_str(_unquote_git_line(s)))
            out.append(abs_path(p if p.is_absolute() else (self.objects_dir / p)))
        return out

    def alternates_point_to(self, objects_dir: Path) -> bool:
        return any(same_path(a, objects_dir) for a in self.alternate_dirs())

    def write_alternates(self, dirs: list[Path]) -> None:
        tmp = self.alternates_file.with_name(f"alternates.{os.getpid()}.tmp")
        try:
            write_lf(tmp, "\n".join(d.as_posix() for d in dirs) + "\n")
            if self.alternates_file.exists():
                _make_writable(self.alternates_file)
            tmp.replace(self.alternates_file)
        except OSError as e:
            with suppress(OSError):
                tmp.unlink(missing_ok=True)
            die(f"failed to update {self.alternates_file.as_posix()}: {e}")

    def objects_kib(self) -> int:
        out = self.out("count-objects", "-v", as_gitdir=True)
        return sum(
            int(parts[1])
            for line in out.splitlines()
            if line.startswith(("size: ", "size-pack: ")) and (parts := line.split())[1].isdigit()
        )

    # --- Remotes, refs, worktrees & submodules ---

    def remotes(self) -> list[Remote]:
        return [
            Remote(k[len("remote.") : -len(".url")], url)
            for k, raw in self.local_config.pairs(r"^remote\..*\.url$")
            if len(k) > len("remote..url") and not (url := RemoteUrl(raw)).is_local
        ]

    def remote_for(self, target: RemoteUrl) -> str | None:
        return next((r.name for r in self.remotes() if target.canonical and r.url.canonical == target.canonical), None)

    def absorb_remotes(self, incoming: list[Remote], opts: Opts) -> None:
        """Add any non-local remotes not yet present on this hub and fetch them."""
        existing_names = {
            k[len("remote.") :].rsplit(".", 1)[0]
            for k in self.local_config.entries()
            if k.startswith("remote.") and k.count(".") > 1
        }
        existing_norms = {c for r in self.remotes() if (c := r.url.canonical)}

        for rem in incoming:
            norm, parts = rem.url.canonical, rem.url.host_and_path
            if not norm or not parts or norm in existing_norms:
                continue
            host, path = parts
            owner = path.split("/")[-2] if "/" in path else path
            for cand in (rem.name, owner, f"{owner}-{host.split('.')[0]}"):
                if not cand or cand in existing_names:
                    continue
                if run_git(["check-ref-format", f"refs/remotes/{cand}/x"]).returncode != 0:
                    continue
                opts.note(f"Adding remote to hub {self.path.as_posix()}: {cand} -> {rem.url.raw}")
                if self.ok("-c", "gc.auto=0", "remote", "add", cand, rem.url.raw):
                    self.local_config.invalidate()
                    existing_names.add(cand)
                    existing_norms.add(norm)
                    fetch_args = ["-c", "gc.auto=0", "fetch", "--prune", "--no-recurse-submodules"]
                    if opts.quiet:
                        fetch_args.append("--quiet")
                    if self.git(*fetch_args, cand, capture=opts.quiet).returncode != 0:
                        warn(f"could not fetch new remote {cand} in hub {self.path.as_posix()}")
                    else:
                        self.git("remote", "set-head", cand, "--auto")
                break
            else:
                warn(f"hub {self.path.as_posix()}: no free remote name for {rem.url.raw}; not added")

    def refs(self, *prefixes: str) -> dict[str, str]:
        return {
            parts[1]: parts[0]
            for line in self.out("for-each-ref", "--format=%(objectname) %(refname)", *prefixes).splitlines()
            if len(parts := line.split(" ", 1)) == 2
        }

    def update_refs(self, commands: list[str]) -> None:
        if commands:
            self.git("update-ref", "--stdin", input="\n".join(commands) + "\n", check=True)

    def worktrees(self, *, as_gitdir: bool = False) -> list[WorktreeInfo]:
        entries: list[WorktreeInfo] = []
        path = head = branch = None
        bare = False
        for line in self.out("worktree", "list", "--porcelain", as_gitdir=as_gitdir).splitlines() + [""]:
            if not line.strip():
                if path is not None:
                    entries.append(WorktreeInfo(path, head, branch, bare))
                    path = head = branch = None
                    bare = False
            elif line.startswith("worktree "):
                path = abs_path(line[len("worktree ") :])
            elif line.startswith("HEAD "):
                head = line[len("HEAD ") :].strip()
            elif line.startswith("branch "):
                branch = line[len("branch ") :].strip()
            elif line == "bare":
                bare = True
        return entries

    def submodules(self) -> list[SubmoduleEntry]:
        if not (self.path / ".gitmodules").is_file():
            return []
        return [
            SubmoduleEntry(k[len("submodule.") : -len(".path")], v)
            for k, v in self.gitmodules.pairs(r"^submodule\..*\.path$")
        ]


# =============================================================================
# 4. Managed Bare Hubs & Canonical-URL Registry
# =============================================================================


def hub_base() -> Path:
    gcfg = GitConfig.global_()
    if configured := gcfg.get("borrow.hubBase") or gcfg.get("borrow.rootBase"):
        return abs_path(configured)
    if xdg := os.environ.get("XDG_CACHE_HOME"):
        return abs_path(Path(norm_str(xdg)) / "git-borrow")
    return abs_path(Path.home() / ".cache" / "git-borrow")


def all_hub_mappings() -> list[tuple[str, Path]]:
    return [
        (k[len("borrow.") : -len(".hub")], abs_path(v))
        for k, v in GitConfig.global_().pairs(r"^borrow\..*\.hub$")
    ]


def mapped_hub(url: RemoteUrl) -> Path | None:
    if not (canon := url.canonical):
        return None
    raw = GitConfig.global_().get(f"borrow.{canon}.hub")
    return abs_path(raw) if raw else None


def record_hub_mappings(remotes: list[Remote], hub: Path, opts: Opts) -> None:
    gcfg = GitConfig.global_()
    for rem in remotes:
        if not (canon := rem.url.canonical):
            continue
        cur = mapped_hub(rem.url)
        if not cur:
            gcfg.set(f"borrow.{canon}.hub", hub.as_posix())
            opts.note(f"Mapped {canon} -> {hub.as_posix()} (global config)")
        elif not same_path(cur, hub):
            warn(f"{canon} is mapped to {cur.as_posix()}, not {hub.as_posix()}; leaving that mapping alone")


def _install_gc_hook(hub: Repo) -> None:
    if hub.config.get("core.hooksPath"):
        warn(
            f"core.hooksPath is set for {hub.path.as_posix()}; not installing pre-auto-gc hook "
            f"(run '{SCRIPT_NAME} gc' instead of git gc)"
        )
        return
    if not (hooks_out := hub.out("rev-parse", "--path-format=absolute", "--git-path", "hooks")):
        return
    hook = abs_path(hooks_out) / "pre-auto-gc"
    desired = (
        "#!/bin/sh\n"
        f"{HOOK_MARKER}: refresh borrower refs so auto gc keeps objects they need.\n"
        '[ -z "$GIT_BORROW_SYNCING" ] || exit 1\n'
        "export GIT_BORROW_SYNCING=1\n"
        "common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1\n"
        "unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \\\n"
        "    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH\n"
        'exec git borrow sync --quiet "$common"\n'
    )
    if hook.is_file():
        with suppress(OSError, UnicodeDecodeError):
            current = hook.read_text("utf-8")
            if HOOK_MARKER not in current:
                warn(
                    f"{hook.as_posix()} exists and is not ours; not replacing it "
                    f"(run '{SCRIPT_NAME} sync' before gc)"
                )
                return
            if current == desired:
                return
    write_lf(hook, desired)
    with suppress(OSError):
        hook.chmod(0o755)


def _validate_bare_hub(hub: Repo) -> None:
    where = hub.path.as_posix()
    if not hub.is_bare:
        die(f"hub path {where} is not a bare repository (bare hubs only)")
    if hub.is_reftable:
        die(f"hub {where} uses extensions.refStorage=reftable; reftable hubs are not supported")
    if hub.is_partial:
        die(f"hub {where} is a partial clone; partial hubs are not supported")
    if hub.object_format != "sha1":
        die(f"hub {where} uses objectFormat={hub.object_format}; only sha1 is supported")


def ensure_hub_setup(hub: Repo, opts: Opts) -> None:
    _validate_bare_hub(hub)
    hub.local_config.set("borrow.isHub", "true")
    hub.local_config.set("uploadpack.allowAnySHA1InWant", "true")
    record_hub_mappings(hub.remotes(), hub.path, opts)
    _install_gc_hook(hub)


def _setup_hub_default_branch(hub: Repo, remote_name: str) -> None:
    """Point bare hub HEAD at the remote's default branch without checking it out."""
    hub.git("remote", "set-head", remote_name, "--auto")
    sym = hub.out("symbolic-ref", "-q", f"refs/remotes/{remote_name}/HEAD")
    prefix = f"refs/remotes/{remote_name}/"
    if not sym.startswith(prefix):
        return
    default_branch = sym[len(prefix) :]
    head_ref = f"refs/heads/{default_branch}"
    if tip := hub.out("rev-parse", "-q", "--verify", sym):
        if not hub.out("rev-parse", "-q", "--verify", head_ref):
            hub.git("update-ref", head_ref, tip, check=True)
            hub.local_config.set(f"branch.{default_branch}.remote", remote_name)
            hub.local_config.set(f"branch.{default_branch}.merge", head_ref)
        hub.git("symbolic-ref", "HEAD", head_ref, check=True)


def _create_bare_hub(hub_path: Path, remotes: list[Remote], seed: Repo | None, opts: Opts) -> Repo:
    pref = preferred_remote(remotes)
    if not pref:
        die("no non-local remote URL to initialize a hub from")
    if run_git(["check-ref-format", f"refs/remotes/{pref.name}/x"]).returncode != 0:
        die(f"invalid remote name: {pref.name}")
    if seed is not None and (seed.is_partial or seed.is_shallow or seed.object_format != "sha1"):
        seed = None

    hub_path.parent.mkdir(parents=True, exist_ok=True)
    # Stage into a sibling temp dir and atomically replace so interrupts never leave partial hubs.
    staging = hub_path.with_name(f".{hub_path.name}.tmp-{os.getpid()}")
    rmtree_force(staging)
    opts.note(f"Creating bare hub {hub_path.as_posix()} ({pref.url.raw})")
    try:
        run_git(["init", "--quiet", "--bare", staging.as_posix()], check=True)
        hub = Repo.open(staging)
        if not hub:
            die(f"failed to open newly initialized hub {staging.as_posix()}")

        if seed is not None:
            opts.note(f"Seeding hub objects from {seed.path.as_posix()}")
            res = hub.git(
                "-c", "protocol.file.allow=always", "-c", "gc.auto=0",
                "fetch", "--no-tags", "--no-recurse-submodules",
                *(["--quiet"] if opts.quiet else []),
                seed.common.as_posix(),
                f"+refs/heads/*:refs/remotes/{pref.name}/*",
                capture=opts.quiet,
            )
            if res.returncode != 0:
                warn(f"could not seed hub from {seed.path.as_posix()}; cloning from remote instead")

        hub.git("remote", "add", pref.name, pref.url.raw, check=True)
        hub.local_config.invalidate()
        fetch_args = ["-c", "gc.auto=0", "fetch", "--prune", "--no-recurse-submodules"] + (
            ["--quiet"] if opts.quiet else []
        )
        if hub.git(*fetch_args, pref.name, capture=opts.quiet).returncode != 0:
            if seed is None or not hub.refs(f"refs/remotes/{pref.name}/"):
                die(f"could not fetch {pref.url.raw} into new hub {hub_path.as_posix()}")
            warn(f"could not fetch {pref.name} in new hub {hub_path.as_posix()}; using seeded objects for now")

        hub.absorb_remotes(remotes, opts)
        _setup_hub_default_branch(hub, pref.name)
        hub.local_config.set("borrow.isHub", "true")
        hub.local_config.set("uploadpack.allowAnySHA1InWant", "true")

        if hub_path.exists():
            if path_occupied(hub_path):
                die(f"hub path {hub_path.as_posix()} became occupied while creating hub")
            hub_path.rmdir()
        staging.replace(hub_path)
    except BaseException:
        with suppress(OSError):
            rmtree_force(staging)
        _prune_empty_parents(hub_path.parent, hub_base())
        raise

    final_hub = Repo.open(hub_path)
    if not final_hub:
        die(f"failed to open hub {hub_path.as_posix()}")
    ensure_hub_setup(final_hub, opts)
    return final_hub


def _resolve_explicit_hub(spec: str, opts: Opts) -> Repo:
    u = RemoteUrl(spec)
    if not u.is_local:
        return resolve_hub([Remote("origin", u)], opts)[0]
    direct = Repo.open(spec)
    repo = direct if (direct and direct.is_bare) else Repo.discover(spec)
    if not repo:
        die(f"--hub is not a Git repository or URL: {spec}")
    hub = repo.associated_hub() or (repo if repo.is_bare else None)
    if not hub or not hub.is_bare:
        die(f"--hub must point to a bare hub (or one of its worktrees/borrowers): {spec}")
    _validate_bare_hub(hub)
    ensure_hub_setup(hub, opts)
    return hub


def _cleanup_failed_new_hub(hub_path: Path) -> None:
    gcfg = GitConfig.global_()
    for canon, mapped in all_hub_mappings():
        if same_path(mapped, hub_path):
            gcfg.unset(f"borrow.{canon}.hub")
    rmtree_force(hub_path)
    _prune_empty_parents(hub_path.parent, hub_base())


def resolve_hub(
    remotes: list[Remote],
    opts: Opts,
    *,
    seed: Repo | None = None,
    explicit_hub: str | None = None,
) -> tuple[Repo, bool]:
    """Resolve or create the canonical bare hub for `remotes`; returns `(hub, created)`."""
    for rem in remotes:
        if not rem.url.is_local and rem.url.has_traversal:
            die(f"refusing remote URL with invalid path traversal segment: {rem.url.raw}")

    if explicit_hub:
        hub = _resolve_explicit_hub(explicit_hub, opts)
        hub.absorb_remotes(remotes, opts)
        record_hub_mappings(remotes, hub.path, opts)
        return hub, False

    mapped: list[Path] = []
    for rem in remotes:
        if (h := mapped_hub(rem.url)) and not any(same_path(h, prev) for prev in mapped):
            mapped.append(h)

    if len(mapped) > 1:
        listing = "\n".join(f"  {p.as_posix()}" for p in mapped)
        die(
            f"remote URLs map to different hubs:\n{listing}\n"
            "unify with 'git config --global borrow.<host/path>.hub <hub-path>' or pass --hub"
        )

    if len(mapped) == 1:
        hub_path = mapped[0]
    else:
        pref = preferred_remote(remotes)
        if not pref or not pref.url.canonical:
            die("no non-local remote URL to derive a hub from")
        hub_path = abs_path(hub_base() / f"{pref.url.canonical}.git")
        if path_under(hub_path, hub_base()) is None:
            die(f"refusing invalid derived hub path outside hubBase: {hub_path.as_posix()}")

    if hub := Repo.open(hub_path):
        _validate_bare_hub(hub)
        hub.absorb_remotes(remotes, opts)
        ensure_hub_setup(hub, opts)
        return hub, False

    if path_occupied(hub_path):
        die(f"hub path {hub_path.as_posix()} exists, is not empty, and is not a Git repository")
    return _create_bare_hub(hub_path, remotes, seed, opts), True


def target_hub_from(raw_path: str = ".") -> Repo:
    u = RemoteUrl(raw_path)
    if not u.is_local:
        if mapped := mapped_hub(u):
            raw_path = mapped.as_posix()
        else:
            die(f"no hub mapped for URL: {raw_path}")
    direct = Repo.open(raw_path)
    repo = direct if (direct and direct.is_bare) else Repo.discover(raw_path)
    if not repo:
        die(f"not a Git repository: {raw_path}")
    if hub := repo.associated_hub():
        _validate_bare_hub(hub)
        return hub
    if repo.is_bare:
        _validate_bare_hub(repo)
        return repo
    die(f"{repo.path.as_posix()} is not associated with a bare hub")


# =============================================================================
# 5. Borrowers, Sync, Canonical-Precondition Dedupe & LFS
# =============================================================================


@dataclass(frozen=True)
class BorrowerRecord:
    borrower_id: str
    common: str
    worktree: str | None
    last_sync: str | None


def register_borrower(hub: Repo, checkout: Repo) -> str:
    """Record borrower metadata under `[borrower "<id>"]` so `git remote` stays clean."""
    b_id = checkout.borrower_id
    hub.local_config.set(f"borrower.{b_id}.common", checkout.common.as_posix())
    hub.local_config.set(f"borrower.{b_id}.worktree", checkout.path.as_posix())
    return b_id


def registered_borrowers(hub: Repo) -> dict[str, BorrowerRecord]:
    raw: dict[str, dict[str, str]] = {}
    for k, v in hub.local_config.pairs(r"^borrower\.[0-9a-f]+\."):
        if m := re.match(r"^borrower\.([0-9a-f]+)\.(.+)$", k):
            raw.setdefault(m.group(1), {})[m.group(2)] = v
    return {
        b_id: BorrowerRecord(b_id, cfg["common"], cfg.get("worktree"), cfg.get("lastsync"))
        for b_id, cfg in raw.items()
        if "common" in cfg
    }


def _collect_borrower_extra_oids(borrower: Repo) -> list[str]:
    """Collect worktree HEADs and in-progress/saved pseudo-ref OIDs to pin in the hub."""
    seen: set[str] = set()
    ordered: list[str] = []

    def add_oid(oid: str | None) -> None:
        if oid and re.fullmatch(r"[0-9a-fA-F]{40,64}", oid) and set(oid) != {"0"} and oid not in seen:
            seen.add(oid)
            ordered.append(oid)

    for wt in borrower.worktrees(as_gitdir=True):
        add_oid(wt.head)

    dirs = [borrower.common]
    if (wt_dir := borrower.common / "worktrees").is_dir():
        dirs.extend(d for d in wt_dir.iterdir() if d.is_dir())
    for d in dirs:
        for name in _PSEUDO_REFS:
            if (pf := d / name).is_file():
                with suppress(OSError, UnicodeDecodeError):
                    for line in pf.read_text("utf-8").splitlines():
                        add_oid(line.strip())
    return ordered


def sync_borrower(hub: Repo, b_id: str, common_path: str | Path | None = None) -> tuple[bool, str]:
    common_val = common_path or hub.local_config.get(f"borrower.{b_id}.common")
    if not common_val:
        return False, "missing borrower.common config"
    borrower = Repo.open(common_val)
    if not borrower:
        warn(
            f"borrower {b_id} is gone ({abs_path(common_val).as_posix()}); keeping its refs. "
            f"'{SCRIPT_NAME} forget {b_id}' to drop them"
        )
        return True, ""

    extra_oids = _collect_borrower_extra_oids(borrower)
    head_specs = [f"+{oid}:{REF_NS}/{b_id}/heads/{idx}" for idx, oid in enumerate(extra_oids)]
    fetch_args = [
        "-c", "protocol.file.allow=always",
        "-c", "gc.auto=0",
        "-c", "maintenance.auto=false",
        "fetch", "--quiet", "--prune", "--no-tags", "--no-recurse-submodules",
        "--upload-pack=git -c uploadpack.allowAnySHA1InWant=true upload-pack",
        borrower.common.as_posix(),
        f"+refs/*:{REF_NS}/{b_id}/refs/*",
        *head_specs,
    ]
    res = hub.git(*fetch_args, env={"GIT_BORROW_SYNCING": "1"})
    if res.returncode != 0:
        return False, res.stderr.strip() or f"fetch exit {res.returncode}"

    stale = [
        ref for ref in hub.refs(f"{REF_NS}/{b_id}/heads/")
        if ref.rsplit("/", 1)[-1].isdigit() and int(ref.rsplit("/", 1)[-1]) >= len(head_specs)
    ]
    hub.update_refs([f"delete {ref}" for ref in stale])
    hub.local_config.set(f"borrower.{b_id}.lastSync", now_iso())
    return True, ""


def forget_borrower_record(hub: Repo, b_id: str, *, keep_refs: bool) -> None:
    hub.local_config.remove_section(f"borrower.{b_id}")
    if not keep_refs:
        hub.update_refs([f"delete {ref}" for ref in hub.refs(f"{REF_NS}/{b_id}/")])


def _active_gc_pid(common: Path) -> int | None:
    if not (gc_pid := common / "gc.pid").is_file():
        return None
    try:
        pid = int(gc_pid.read_text("utf-8").split()[0])
    except (OSError, UnicodeDecodeError, ValueError, IndexError):
        return None
    return pid if pid_alive(pid) else None


def _verify_canonical_borrower(borrower: Repo, hub: Repo) -> None:
    """Fail fast on exotic repository configurations instead of attempting fragile surgery."""
    where = borrower.common.as_posix()
    if borrower.is_bare:
        die(f"{where} is a bare repository; cannot link a bare repository as a borrower")
    if borrower.is_partial:
        die(f"{where} is a partial clone (promisor remote); partial clones are not supported")
    if borrower.is_shallow:
        die(f"{where} is a shallow clone; shallow clones are not supported")
    if borrower.is_reftable:
        die(f"{where} uses extensions.refStorage=reftable; reftable borrowers are not supported")
    if borrower.object_format != hub.object_format:
        die(
            f"{where} uses objectFormat={borrower.object_format}, "
            f"which does not match hub {hub.path.as_posix()} ({hub.object_format})"
        )
    if foreign_alts := [a for a in borrower.alternate_dirs() if not same_path(a, hub.objects_dir)]:
        die(
            f"{where} already has foreign alternates ({', '.join(a.as_posix() for a in foreign_alts)}); "
            "dissociate first with 'git repack -a -d' and remove objects/info/alternates"
        )
    if keep_files := sorted(borrower.pack_dir.glob("pack-*.keep")):
        die(
            f"{where} has .keep pack file(s) ({', '.join(p.name for p in keep_files)}); "
            "remove stale .keep files or wait for running git transfer"
        )
    if (active_pid := _active_gc_pid(borrower.common)) is not None:
        die(f"active git gc (pid {active_pid}) appears to be running in {where}; try again later")


@contextmanager
def _transactional_alternates(borrower: Repo, target_dir: Path):
    """Switch alternates atomically, restoring original file/absence if repack fails or aborts."""
    alt_file = borrower.alternates_file
    existed = alt_file.is_file()
    prev_bytes = b""
    if existed:
        try:
            prev_bytes = alt_file.read_bytes()
        except OSError as e:
            die(f"cannot read {alt_file.as_posix()}: {e}")

    committed = False

    def commit() -> None:
        nonlocal committed
        committed = True

    try:
        borrower.write_alternates([target_dir])
        yield commit
    finally:
        if not committed:
            with suppress(OSError):
                if existed:
                    if alt_file.exists():
                        _make_writable(alt_file)
                    alt_file.write_bytes(prev_bytes)
                else:
                    alt_file.unlink(missing_ok=True)


def dedupe_objects(borrower: Repo, hub: Repo, opts: Opts) -> None:
    """Point `borrower` at `hub`'s object store and drop redundant objects via `git repack -A -d -l`."""
    before_kib = borrower.objects_kib()
    with _transactional_alternates(borrower, hub.objects_dir) as commit_alternates:
        opts.note(f"Repacking {borrower.common.as_posix()} against hub {hub.path.as_posix()} ({before_kib} KiB local)...")
        repack_args = ["repack", "-A", "-d", "-l"] + (["-q"] if opts.quiet else [])
        res = borrower.git(*repack_args, as_gitdir=True, capture=opts.quiet)
        if res.returncode != 0:
            detail = res.stderr.strip() or f"exit {res.returncode}"
            die(f"git repack -A -d -l failed in {borrower.common.as_posix()}: {detail}")
        commit_alternates()

    after_kib = borrower.objects_kib()
    saved = max(0, before_kib - after_kib)
    opts.note(f"Deduplicated {borrower.common.as_posix()}: local objects {before_kib} KiB -> {after_kib} KiB (saved {saved} KiB)")


def has_lfs(*repos: Repo | None) -> bool:
    for repo in repos:
        if repo is None:
            continue
        if (lfs_objs := repo.common / "lfs" / "objects").is_dir() and any(os.scandir(lfs_objs)):
            return True
        if (ga := repo.path / ".gitattributes").is_file():
            with suppress(OSError, UnicodeDecodeError):
                if _LFS_ATTR_RE.search(ga.read_text("utf-8", errors="ignore")):
                    return True
    return False


def configure_shared_lfs(checkout: Repo, hub: Repo, opts: Opts, *, migrate_existing: bool) -> None:
    """Point `checkout` at the hub's shared `lfs.storage` directory (preserving existing media)."""
    if opts.lfs_mode == "none" or not has_lfs(checkout, hub):
        return
    if (existing_storage := checkout.target_config.get("lfs.storage")) and not same_path(
        existing_storage, checkout.lfs_dir
    ) and not same_path(existing_storage, hub.lfs_dir):
        die(
            f"{checkout.path.as_posix()} already has custom lfs.storage={existing_storage}; "
            "unset it or pass --lfs=none instead of silently overwriting"
        )
    hub.lfs_dir.mkdir(parents=True, exist_ok=True)
    if migrate_existing:
        local_objs = checkout.common / "lfs" / "objects"
        if local_objs.is_dir() and not same_path(checkout.lfs_dir, hub.lfs_dir):
            shutil.copytree(local_objs, hub.lfs_dir / "objects", dirs_exist_ok=True)
    checkout.target_config.set("lfs.storage", hub.lfs_dir.as_posix())
    if not checkout.ok("lfs", "checkout"):
        warn(f"git lfs checkout failed in {checkout.path.as_posix()}")


def borrow_via_alternates(checkout: Repo, hub: Repo, opts: Opts) -> None:
    if same_path(checkout.common, hub.common):
        opts.note(f"{checkout.path.as_posix()} is already a worktree of hub {hub.path.as_posix()}; nothing to link")
        return

    _verify_canonical_borrower(checkout, hub)

    opts.note(f"Linking {checkout.path.as_posix()} -> hub {hub.path.as_posix()}")
    hub.absorb_remotes(checkout.remotes(), opts)
    record_hub_mappings(checkout.remotes(), hub.path, opts)

    b_id = checkout.borrower_id
    was_registered = hub.local_config.get(f"borrower.{b_id}.common") is not None
    register_borrower(hub, checkout)
    try:
        ok, err = sync_borrower(hub, b_id, checkout.common)
        if not ok:
            die(f"failed to sync borrower {checkout.path.as_posix()} to hub {hub.path.as_posix()}: {err}")
        dedupe_objects(checkout, hub, opts)
    except BaseException:
        if not was_registered:
            with suppress(BaseException):
                forget_borrower_record(hub, b_id, keep_refs=False)
        raise

    checkout.breadcrumb().write(
        linked=now_iso(),
        hub=hub.path.as_posix(),
        id=b_id,
        lfs_mode=opts.lfs_mode,
    )
    configure_shared_lfs(checkout, hub, opts, migrate_existing=True)


def link_borrower(
    path: str | Path,
    opts: Opts,
    *,
    hub_override: str | None = None,
    allow_standalone: bool = False,
) -> None:
    checkout = Repo.discover(path)
    if not checkout or checkout.is_bare:
        die(f"not a Git worktree: {path}")
    if (existing_hub := checkout.associated_hub()) and same_path(checkout.common, existing_hub.common):
        opts.note(f"{checkout.path.as_posix()} is already a worktree of hub {existing_hub.path.as_posix()}; nothing to link")
        return
    if not checkout.superproject() and not allow_standalone:
        die(
            f"{checkout.path.as_posix()} is a standalone repository, not a submodule; "
            f"prefer creating a linked worktree via '{SCRIPT_NAME} clone' (or pass --force to borrow via alternates)"
        )
    remotes = checkout.remotes()
    if not remotes and not hub_override:
        die(f"{checkout.path.as_posix()} has no non-local remote URL (pass --hub to specify)")
    hub, _ = resolve_hub(remotes, opts, seed=checkout, explicit_hub=hub_override)
    borrow_via_alternates(checkout, hub, opts)


# =============================================================================
# 6. Worktree Materialization & Submodules
# =============================================================================


def materialize_worktree(hub: Repo, target: Path, opts: Opts, *, rem: str, spec: CheckoutSpec) -> Repo:
    """Create `target` as a linked worktree of bare `hub`, falling back to `--detach` on checked-out branches."""
    req = spec.requested_branch
    refs = hub.refs("refs/heads/", f"refs/remotes/{rem}/")
    remote_head = hub.out("symbolic-ref", "-q", f"refs/remotes/{rem}/HEAD")
    default_branch = (
        remote_head[len(f"refs/remotes/{rem}/") :]
        if remote_head.startswith(f"refs/remotes/{rem}/")
        else None
    )

    if req and f"refs/remotes/{rem}/{req}" in refs:
        start_ref = f"refs/remotes/{rem}/{req}"
    elif req and f"refs/heads/{req}" in refs:
        start_ref = f"refs/heads/{req}"
    elif remote_head and remote_head in refs:
        start_ref = remote_head
    elif default_branch and f"refs/heads/{default_branch}" in refs:
        start_ref = f"refs/heads/{default_branch}"
    else:
        first_branch = next((r for r in sorted(refs) if r.startswith(f"refs/remotes/{rem}/")), None)
        start_ref = first_branch or next((r for r in sorted(refs) if r.startswith("refs/heads/")), "HEAD")

    if not hub.ok("rev-parse", "-q", "--verify", f"{start_ref}^{{commit}}"):
        die(f"hub {hub.path.as_posix()} has no commits yet (unborn HEAD); cannot create worktree")

    base = ["-c", "submodule.recurse=false", "worktree", "add"] + (["-q"] if opts.quiet else [])
    wt_env, target_s = opts.skip_smudge_env(), target.as_posix()
    checked_out = {w.branch for w in hub.worktrees() if w.branch}

    def run_wt_add(*extra: str) -> None:
        res = hub.git(*base, *extra, capture=False, env=wt_env)
        if res.returncode != 0:
            if target.exists() and not Repo.open(target):
                with suppress(OSError):
                    rmtree_force(target)
                hub.git("worktree", "prune")
            die(f"git worktree add failed for {target_s}")

    if spec.detach:
        run_wt_add("--detach", target_s, start_ref)
    elif spec.force_branch:
        if f"refs/heads/{spec.force_branch}" in checked_out:
            warn(f"branch {spec.force_branch} is already checked out elsewhere; leaving {target_s} detached")
            run_wt_add("--detach", target_s, start_ref)
        else:
            run_wt_add("-B", spec.force_branch, target_s, start_ref)
    elif spec.branch:
        if f"refs/heads/{spec.branch}" in checked_out:
            warn(f"branch {spec.branch} is already checked out elsewhere; leaving {target_s} detached")
            run_wt_add("--detach", target_s, start_ref)
        else:
            try_args = [target_s, spec.branch] if f"refs/heads/{spec.branch}" in refs else ["-b", spec.branch, target_s, start_ref]
            run_wt_add(*try_args)
    else:
        # First clone gets the remote's default branch if free; subsequent clones use target.name if valid & free.
        if default_branch and f"refs/heads/{default_branch}" not in checked_out:
            want_b = default_branch
            head_ref = f"refs/heads/{default_branch}"
            if head_ref in refs and remote_head in refs and hub.ok("merge-base", "--is-ancestor", head_ref, remote_head):
                hub.git("update-ref", head_ref, refs[remote_head])
            try_args = [target_s, want_b] if head_ref in refs else ["-b", want_b, target_s, start_ref]
            run_wt_add(*try_args)
        else:
            want_b = target.name
            valid_name = run_git(["check-ref-format", "--branch", want_b]).returncode == 0
            if not valid_name or f"refs/heads/{want_b}" in checked_out:
                if valid_name:
                    warn(f"branch {want_b} is already checked out elsewhere; leaving {target_s} detached")
                run_wt_add("--detach", target_s, start_ref)
            else:
                try_args = [target_s, want_b] if f"refs/heads/{want_b}" in refs else ["-b", want_b, target_s, start_ref]
                run_wt_add(*try_args)

    if not (checkout := Repo.open(target)):
        die(f"could not determine git dir for new worktree {target_s}")
    return checkout


def _ensure_nonbare_worktree_config(repo: Repo) -> None:
    """Guard linked worktrees when `extensions.worktreeConfig=true` exposes hub `core.bare=true`."""
    if (
        not repo.is_bare
        and not same_path(repo.gitdir, repo.common)
        and repo.config.bool("extensions.worktreeConfig") is True
        and repo.local_config.bool("core.bare") is True
    ):
        wt_cfg = GitConfig.worktree(repo.path, repo.gitdir, repo.common)
        if wt_cfg.get("core.bare") is None:
            wt_cfg.set("core.bare", "false")


def finish_new_checkout(
    checkout: Repo,
    opts: Opts,
    *,
    hub: Repo | None,
    breadcrumb_from: Path,
    init_seed: Repo | None,
    init_all: bool = False,
) -> None:
    _ensure_nonbare_worktree_config(checkout)
    checkout.breadcrumb(in_gitdir=True).write(
        created=now_iso(), from_=breadcrumb_from.as_posix(), lfs_mode=opts.lfs_mode
    )
    if hub is not None:
        configure_shared_lfs(checkout, hub, opts, migrate_existing=False)
    elif opts.lfs_mode != "none" and has_lfs(checkout):
        checkout.git("lfs", "checkout")
    if opts.recursive:
        init_submodules(checkout, opts, seed=init_seed, init_all=init_all)


def _submodule_update(wt: Repo, opts: Opts, extra_args: list[str], *, config_overrides: list[str] = ()) -> bool:
    args = [*config_overrides, "submodule", "update", "--init"]
    if opts.jobs:
        args += ["--jobs", opts.jobs]
    if opts.quiet:
        args.append("--quiet")
    return wt.git(*args, *extra_args, capture=False, env=opts.skip_smudge_env()).returncode == 0


def _clone_submodule_from_hub(wt: Repo, name: str, path_val: str, real_url: str, hub: Repo, opts: Opts) -> bool:
    sub_path = wt.path / path_val
    # Never run destructive cleanup against a directory that already held user files.
    if path_occupied(sub_path) or (sub_path / ".git").exists():
        die(f"submodule path {sub_path.as_posix()} already exists or has a broken .git entry")

    # Override submodule.<name>.url transiently via -c so shared hub/config is never mutated.
    ok = _submodule_update(
        wt,
        opts,
        ["--reference", hub.common.as_posix(), "--", path_val],
        config_overrides=["-c", f"submodule.{name}.url={hub.path.as_posix()}"],
    )
    if ok:
        if sub := Repo.open(sub_path):
            sub.git("remote", "set-url", "origin", real_url)
            sub.local_config.invalidate()
        return True
    rmtree_force(sub_path)
    rmtree_force(wt.gitdir / "modules" / name)
    return False


def init_submodules(
    wt: Repo,
    opts: Opts,
    *,
    seed: Repo | None = None,
    init_all: bool = False,
    only_path: str | None = None,
) -> None:
    """Link initialized submodules, or init those present in `seed` (or all if `init_all`)."""
    _ensure_nonbare_worktree_config(wt)
    for entry in wt.submodules():
        if not entry.path or (only_path is not None and entry.path != only_path):
            continue
        sub_path = abs_path(wt.path / entry.path)
        sub_seed: Repo | None = None
        if seed is not None:
            cand_p = abs_path(seed.path / entry.path)
            if (cand := Repo.discover(cand_p)) and same_path(cand.path, cand_p) and not cand.is_partial and not cand.is_shallow:
                sub_seed = cand

        if (existing := Repo.discover(sub_path)) and same_path(existing.path, sub_path):
            opts.note(f"Submodule already initialized: {entry.path}")
            link_borrower(existing.path, opts)
            init_submodules(existing, opts, seed=sub_seed, init_all=init_all)
        elif (sub_path / ".git").exists() or path_occupied(sub_path):
            die(f"submodule path {sub_path.as_posix()} is non-empty or has a broken .git pointer")
        elif sub_seed or init_all:
            raw_gm_url = wt.gitmodules.get(f"submodule.{entry.name}.url") or ""
            resolved_url = _resolve_relative_submodule_url(wt, raw_gm_url)
            wt.git("submodule", "init", "--", entry.path, check=True)
            wt.git("submodule", "sync", "--quiet", "--", entry.path, check=True)
            wt.config.invalidate()
            url = wt.config.get(f"submodule.{entry.name}.url")
            if not url:
                opts.note(f"Skipping inactive submodule: {entry.path}")
                continue
            if RemoteUrl(url).is_local and resolved_url != raw_gm_url:
                url = resolved_url
                wt.target_config.set(f"submodule.{entry.name}.url", url)
            if RemoteUrl(url).is_local:
                die(f"submodule {entry.path} has local/unresolvable URL '{url}'; cannot borrow from a hub")

            hub, _ = resolve_hub([Remote("origin", RemoteUrl(url))], opts, seed=sub_seed)
            opts.note(f"Initializing submodule {entry.path} borrowing from hub {hub.path.as_posix()}")
            if not _clone_submodule_from_hub(wt, entry.name, entry.path, url, hub, opts):
                warn(
                    f"hub {hub.path.as_posix()} doesn't have the commit {entry.path} needs; "
                    "cloning from the network instead"
                )
                if not _submodule_update(wt, opts, ["--reference", hub.common.as_posix(), "--", entry.path]):
                    rmtree_force(sub_path)
                    rmtree_force(wt.gitdir / "modules" / entry.name)
                    die(f"failed to initialize submodule {entry.path} from {url}")
            if sub := Repo.open(sub_path):
                link_borrower(sub.path, opts, hub_override=hub.path.as_posix())
                init_submodules(sub, opts, seed=sub_seed, init_all=init_all)
        else:
            opts.note(f"Skipping uninitialized submodule {sub_path.as_posix()}")


def _run_submodule_add(
    super_repo: Repo,
    dest_rel: str,
    url: str,
    opts: Opts,
    *,
    branch: str | None,
    name: str | None,
    force: bool = False,
    reference: str | None = None,
) -> subprocess.CompletedProcess[str]:
    cmd = ["-c", "protocol.file.allow=always", "submodule", "add"]
    if opts.quiet:
        cmd.append("--quiet")
    if force:
        cmd.append("--force")
    if branch:
        cmd += ["-b", branch]
    if name:
        cmd += ["--name", name]
    if reference:
        cmd += ["--reference", reference]
    return super_repo.git(*cmd, "--", url, dest_rel, capture=False)


# =============================================================================
# 7. Status Reporting & CLI Commands
# =============================================================================


def _print_hub_remotes(hub: Repo, *, borrower: Repo | None = None) -> None:
    remotes = hub.remotes()
    if borrower is None:
        sys.stdout.write("  Remotes:\n")
        if not remotes:
            sys.stdout.write("    (none)\n")
        for rem in remotes:
            sys.stdout.write(f"    {rem.name}  {rem.url.raw}\n")
        return

    b_norms = {c for r in borrower.remotes() if (c := r.url.canonical)}
    sys.stdout.write("  Hub remotes:\n")
    if not remotes:
        sys.stdout.write("    (none)\n")
    for rem in remotes:
        if rem.url.canonical in b_norms:
            sys.stdout.write(f"    {rem.name}  {rem.url.raw}  [present]\n")
        else:
            sys.stdout.write(
                f"    {rem.name}  {rem.url.raw}  [available: git remote add {rem.name} {rem.url.raw}]\n"
            )


def _print_hub_worktrees(hub: Repo) -> None:
    wt_dir = hub.common / "worktrees"
    if not wt_dir.is_dir():
        return
    admins = [w for w in sorted(wt_dir.iterdir()) if w.is_dir() and (w / "gitdir").is_file()]
    if not admins:
        return
    sys.stdout.write("  Linked worktrees:\n")
    for admin in admins:
        with suppress(OSError, UnicodeDecodeError):
            gd_target = Path(norm_str((admin / "gitdir").read_text("utf-8").strip()))
            wt = abs_path((gd_target if gd_target.is_absolute() else (admin / gd_target)).parent)
            bc = KVFile(admin / BREADCRUMB_FILE).read()
            kind = f"git borrow worktree, {bc['created']}" if "created" in bc else "plain"
            n_sub = n_borrow = 0
            if (modules_dir := admin / "modules").is_dir():
                for root_dir, _, files in os.walk(modules_dir):
                    if "worktrees" not in Path(root_dir).relative_to(modules_dir).parts:
                        n_sub += "config" in files
                        n_borrow += BREADCRUMB_FILE in files
            if not wt.is_dir():
                kind = f"{kind}; MISSING (git worktree prune)"
            suffix = f"; {n_borrow}/{n_sub} submodules borrow" if n_sub > 0 else ""
            sys.stdout.write(f"    {wt.as_posix()}  [{kind}{suffix}]\n")


def _print_hub_borrowers(hub: Repo) -> None:
    sys.stdout.write("  Borrowers:\n")
    borrowers = registered_borrowers(hub)
    if not borrowers:
        sys.stdout.write("    (none)\n")
    for b_id, rec in borrowers.items():
        b_repo = Repo.open(rec.common)
        if not b_repo:
            state = "MISSING (refs kept)"
        elif b_repo.alternates_point_to(hub.objects_dir):
            state = "ok"
        else:
            state = "not borrowing from here"
        sys.stdout.write(f"    {b_id}  {rec.worktree or '?'}  [{state}, synced {rec.last_sync or 'never'}]\n")

    arch_ids = sorted(
        {m.group(1) for ref in hub.refs(f"{REF_NS}/") if (m := re.match(rf"^{REF_NS}/([0-9a-f]+)/", ref))}
    )
    for arch_id in arch_ids:
        if arch_id not in borrowers:
            sys.stdout.write(f"    {arch_id}  (archived refs only, {REF_NS}/{arch_id}/)\n")


def _print_submodule_summary(wt: Repo, prefix: str, seen: set[str] | None = None) -> None:
    visited = seen if seen is not None else {wt.common.as_posix()}
    for entry in wt.submodules():
        if not entry.path:
            continue
        sub_path = abs_path(wt.path / entry.path)
        sub = Repo.discover(sub_path)
        if not sub or not same_path(sub.path, sub_path):
            sys.stdout.write(f"{prefix}{entry.path}: not initialized\n")
            continue
        if h := sub.breadcrumb().get("hub"):
            alts, hub_repo = sub.alternate_dirs(), Repo.open(h)
            msg = (
                f"borrower of {h}"
                if alts and hub_repo and same_path(alts[0], hub_repo.objects_dir)
                else f"breadcrumb says {h}, but alternates do not point there"
            )
            sys.stdout.write(f"{prefix}{entry.path}: {msg}\n")
        else:
            sys.stdout.write(f"{prefix}{entry.path}: not linked\n")
        if sub.common.as_posix() not in visited:
            _print_submodule_summary(sub, f"{prefix}  ", visited | {sub.common.as_posix()})


def _resolve_worktree_args(raw_args: list[str]) -> tuple[Path | None, list[str]]:
    skip, target, after_ddash, out = False, None, False, []
    for arg in raw_args:
        if arg == "--" and not after_ddash:
            after_ddash = True
            out.append(arg)
        elif target is not None:
            out.append(arg)
        elif skip:
            skip = False
            out.append(arg)
        elif not after_ddash and arg in ("-b", "-B", "--reason"):
            skip = True
            out.append(arg)
        elif not after_ddash and arg.startswith("-"):
            out.append(arg)
        else:
            target = abs_path(arg)
            out.append(target.as_posix())
    return target, out


def _strip_branch_flags(args: list[str]) -> list[str]:
    skip, after_ddash, out = False, False, []
    for arg in args:
        if arg == "--" and not after_ddash:
            after_ddash = True
            out.append(arg)
        elif after_ddash:
            out.append(arg)
        elif skip:
            skip = False
        elif arg in ("-b", "-B"):
            skip = True
        elif arg == "--orphan" or arg.startswith(("-b", "-B", "--orphan=")):
            continue
        else:
            out.append(arg)
    return out


def cmd_clone(raw_args: list[str], opts: Opts, *, spec: CheckoutSpec, origin: str) -> None:
    if not 1 <= len(raw_args) <= 2:
        die(f"usage: {SCRIPT_NAME} clone [options] <url> [<dir>]")
    if spec.branch and spec.force_branch:
        die("cannot specify both -b and -B")
    if origin and run_git(["check-ref-format", f"refs/remotes/{origin}/x"]).returncode != 0:
        die(f"invalid remote name: {origin}")

    raw_url, url = raw_args[0], RemoteUrl(raw_args[0])
    target = (
        abs_path(raw_args[1])
        if len(raw_args) == 2
        else abs_path(url.fallback_name or die(f"could not determine target directory from URL: {raw_url}"))
    )
    if path_occupied(target):
        die(f"destination path '{target.as_posix()}' already exists and is not an empty directory")

    seed: Repo | None = None
    if url.is_local:
        resolved = abs_path(url.local_path_str)
        if not resolved.exists():
            die(f"directory does not exist: {raw_url}")
        if not (seed := Repo.discover(resolved) or Repo.open(resolved)):
            die(f"not a Git repository: {raw_url}")
        if not (remotes := seed.remotes()):
            die(f"repository {raw_url} has no non-local remote URLs to derive a hub from")
    else:
        remotes = [Remote(origin, url)]

    hub, created = resolve_hub(remotes, opts, seed=seed, explicit_hub=opts.explicit_hub)
    try:
        pref = preferred_remote(remotes)
        rem = (pref and hub.remote_for(pref.url)) or origin
        if not created:
            fetch_args = ["-c", "gc.auto=0", "fetch", "--prune", "--no-recurse-submodules"] + (
                ["--quiet"] if opts.quiet else []
            )
            if hub.git(*fetch_args, rem, capture=opts.quiet).returncode != 0:
                warn(f"could not fetch {rem} in hub {hub.path.as_posix()}; using cached objects")

        checkout = materialize_worktree(hub, target, opts, rem=rem, spec=spec)
        if opts.recursive is None:
            opts.recursive = checkout.recursion_default
        finish_new_checkout(
            checkout, opts,
            hub=hub,
            breadcrumb_from=hub.path,
            init_seed=seed,
            init_all=(seed is None),
        )
    except BaseException:
        if created:
            with suppress(BaseException):
                _cleanup_failed_new_hub(hub.path)
        raise


def cmd_add(raw_args: list[str], opts: Opts) -> None:
    if not raw_args:
        die(f"usage: {SCRIPT_NAME} add [options] [--] <git worktree add args>")
    from_repo = Repo.discover(".") or (Repo.open(".") if (Repo.open(".") and Repo.open(".").is_bare) else None)
    if not from_repo:
        die("not in a Git repository; run this from inside a repository (or use 'git -C <repo> borrow add ...')")
    _ensure_nonbare_worktree_config(from_repo)
    target, add_args = _resolve_worktree_args(raw_args)
    if not target:
        die("could not determine target path from arguments")
    if path_occupied(target):
        die(f"target already exists: {target.as_posix()}")

    if opts.recursive is None:
        opts.recursive = from_repo.recursion_default
    prefix = ["-c", "submodule.recurse=false", "worktree", "add"]
    if opts.quiet:
        prefix.append("-q")
    if opts.force:
        prefix.append("-f")

    wt_env = opts.skip_smudge_env()
    c_env = {**(wt_env or {}), "LC_ALL": "C"}
    res = from_repo.git(*prefix, *add_args, env=c_env)
    if res.returncode != 0:
        err_low = res.stderr.lower()
        is_branch_collision = "--detach" not in add_args and (
            "already used by worktree" in err_low
            or "already checked out" in err_low
            or ("a branch named" in err_low and "already exists" in err_low)
        )
        if is_branch_collision:
            warn(f"branch collision ({res.stderr.strip()}); falling back to --detach")
            from_repo.git(*prefix, "--detach", *_strip_branch_flags(add_args), check=True, capture=False, env=wt_env)
        else:
            if res.stderr:
                sys.stderr.write(res.stderr)
            die(f"git worktree add failed for {target.as_posix()}", exit_code=res.returncode or 1)
    elif res.stderr and not opts.quiet:
        sys.stderr.write(res.stderr)

    if checkout := Repo.open(target):
        finish_new_checkout(
            checkout, opts,
            hub=from_repo.associated_hub(),
            breadcrumb_from=from_repo.path,
            init_seed=from_repo,
        )


def cmd_link(target: str, opts: Opts) -> None:
    target_p = abs_path(target)
    checkout = Repo.discover(target_p)
    if not checkout or checkout.is_bare:
        die(f"not a Git worktree: {target}")
    if target != "." and not same_path(checkout.path, target_p):
        die(f"{target} is a subdirectory of {checkout.path.as_posix()}; pass the repository root")
    if opts.recursive is None:
        opts.recursive = checkout.recursion_default
    _ensure_nonbare_worktree_config(checkout)
    link_borrower(checkout.path, opts, hub_override=opts.explicit_hub, allow_standalone=opts.force)
    if opts.recursive:
        init_submodules(checkout, opts, seed=None)


def _absorb_primary_submodule(
    super_repo: Repo,
    existing_tree: Path,
    dest_path: Path,
    dest_rel: str,
    opts: Opts,
    *,
    branch: str | None,
    name: str | None,
) -> None:
    """Absorb a primary standalone clone as a borrowed submodule via `git submodule absorbgitdirs`."""
    src_repo = Repo.open(existing_tree)
    if not src_repo or src_repo.is_bare or not src_repo.is_primary:
        die(
            f"cannot absorb linked worktree {existing_tree.as_posix()} as a submodule; "
            f"use '{SCRIPT_NAME} submodule add <url> <path>' instead"
        )
    if len(src_repo.worktrees()) > 1:
        die(f"cannot absorb {existing_tree.as_posix()}: repository has linked worktrees")
    if not src_repo.out("rev-parse", "-q", "--verify", "HEAD"):
        die(f"cannot absorb {existing_tree.as_posix()}: repository has no commits (unborn HEAD)")

    if (sp := src_repo.superproject()) and same_path(sp, super_repo.path):
        link_borrower(existing_tree, opts, hub_override=opts.explicit_hub)
        return

    pref = preferred_remote(src_repo.remotes())
    if not pref and opts.explicit_hub:
        pref = preferred_remote(_resolve_explicit_hub(opts.explicit_hub, opts).remotes())
    if not pref:
        die(f"existing tree {existing_tree.as_posix()} has no non-local remote URL (pass --hub to specify)")

    hub, _ = resolve_hub(src_repo.remotes() or [pref], opts, seed=src_repo, explicit_hub=opts.explicit_hub)
    _verify_canonical_borrower(src_repo, hub)

    old_hub_path = src_repo.breadcrumb().get("hub")
    old_b_id = src_repo.borrower_id
    moved = False

    if not same_path(existing_tree, dest_path):
        if path_occupied(dest_path):
            die(f"destination path '{dest_path.as_posix()}' already exists and is not an empty directory")
        opts.note(f"Moving {existing_tree.as_posix()} -> {dest_path.as_posix()}")
        dest_path.parent.mkdir(parents=True, exist_ok=True)
        if dest_path.is_dir():
            dest_path.rmdir()
        shutil.move(existing_tree.as_posix(), dest_path.as_posix())
        moved = True

    try:
        if _run_submodule_add(super_repo, dest_rel, pref.url.raw, opts, branch=branch, name=name, force=True).returncode != 0:
            die(f"git submodule add failed for {dest_rel}")
        super_repo.git("submodule", "absorbgitdirs", "--", dest_rel, check=True)
    except BaseException:
        if moved and dest_path.exists() and not existing_tree.exists():
            with suppress(OSError):
                shutil.move(dest_path.as_posix(), existing_tree.as_posix())
        raise

    link_borrower(dest_path, opts, hub_override=hub.path.as_posix())
    if old_hub_path and (old_hub := Repo.open(old_hub_path)) and old_hub.is_hub:
        if (new_sub := Repo.open(dest_path)) and old_b_id != new_sub.borrower_id:
            forget_borrower_record(old_hub, old_b_id, keep_refs=False)
    if opts.recursive and (sub := Repo.open(dest_path)):
        init_submodules(sub, opts, init_all=False)


def cmd_submodule(
    raw_args: list[str],
    opts: Opts,
    *,
    branch: str | None,
    name: str | None,
) -> None:
    if not 1 <= len(raw_args) <= 2:
        die(f"usage: {SCRIPT_NAME} submodule [add] [options] <url|existing-path> [<path>]")
    if not (super_repo := Repo.discover(".")) or super_repo.is_bare:
        die("not in a Git working tree; run this inside a checkout (or use 'git -C <repo> borrow submodule ...')")
    _ensure_nonbare_worktree_config(super_repo)

    first, second = raw_args[0], (raw_args[1] if len(raw_args) == 2 else None)
    existing_tree: Path | None = None

    if Repo.is_worktree_path(first):
        existing_tree = abs_path(first)
        if second:
            dest_path = abs_path(second)
        elif path_under(existing_tree, super_repo.path) is not None:
            dest_path = existing_tree
        else:
            dest_path = abs_path(existing_tree.name)
    else:
        u = RemoteUrl(first)
        if u.is_local:
            p = abs_path(u.local_path_str)
            if p.exists():
                die(f"cannot add bare or non-worktree local path as submodule: {first}")
            if first.startswith(("./", "../")):
                first = _resolve_relative_submodule_url(super_repo, first)
                u = RemoteUrl(first)
            else:
                die(f"directory does not exist: {first}")
        dest_arg = second or u.fallback_name
        if not dest_arg:
            die(f"could not determine submodule path from URL: {first}")
        dest_path = abs_path(dest_arg)

    dest_rel = rel_posix(dest_path, super_repo.path)
    if dest_rel in (".", "..") or dest_rel.startswith("../"):
        die(f"submodule path must be inside repository {super_repo.path.as_posix()}: {dest_path.as_posix()}")

    sub_name = name or dest_rel
    if registered_path := super_repo.gitmodules.get(f"submodule.{sub_name}.path"):
        if Repo.open(dest_path):
            opts.note(f"Submodule '{sub_name}' already exists at {dest_rel}; linking it")
            link_borrower(dest_path, opts, hub_override=opts.explicit_hub)
        else:
            opts.note(f"Submodule '{sub_name}' already registered in .gitmodules; initializing it")
            init_submodules(super_repo, opts, init_all=True, only_path=registered_path)
        return

    if opts.recursive is None:
        opts.recursive = super_repo.recursion_default

    if existing_tree is not None:
        _absorb_primary_submodule(
            super_repo, existing_tree, dest_path, dest_rel, opts, branch=branch, name=name
        )
        return

    if path_occupied(dest_path) or (dest_path / ".git").exists():
        die(f"destination path '{dest_path.as_posix()}' already exists and is not empty")

    url = first
    hub, _ = resolve_hub([Remote("origin", RemoteUrl(url))], opts, explicit_hub=opts.explicit_hub)
    add_kw = dict(branch=branch, name=name, force=opts.force, reference=hub.common.as_posix())
    if _run_submodule_add(super_repo, dest_rel, url, opts, **add_kw).returncode != 0:
        rmtree_force(dest_path)
        rmtree_force(super_repo.gitdir / "modules" / sub_name)
        if _run_submodule_add(super_repo, dest_rel, hub.path.as_posix(), opts, **add_kw).returncode != 0:
            rmtree_force(dest_path)
            rmtree_force(super_repo.gitdir / "modules" / sub_name)
            die(f"git submodule add failed for {url}")
        super_repo.gitmodules.set(f"submodule.{sub_name}.url", url)
        super_repo.target_config.set(f"submodule.{sub_name}.url", url)
        if sub := Repo.open(dest_path):
            sub.git("remote", "set-url", "origin", url)
            sub.local_config.invalidate()
        super_repo.git("add", ".gitmodules", check=True)

    link_borrower(dest_path, opts, hub_override=hub.path.as_posix())
    if opts.recursive and (sub := Repo.open(dest_path)):
        init_submodules(sub, opts, init_all=True)


def cmd_hub(arg: str | None, opts: Opts) -> None:
    if opts.explicit_hub and arg:
        u = RemoteUrl(arg)
        remotes = [Remote("origin", u)] if not u.is_local else (
            (Repo.open(arg) or Repo.discover(arg) or die(f"not a repository or remote URL: {arg}")).remotes()
        )
        hub, _ = resolve_hub(remotes, opts, explicit_hub=opts.explicit_hub)
    elif opts.explicit_hub:
        hub = _resolve_explicit_hub(opts.explicit_hub, opts)
    else:
        target = arg or "."
        u = RemoteUrl(target)
        if u.is_local and (repo := Repo.open(target) or Repo.discover(target)):
            if not (hub := repo.associated_hub()):
                hub, _ = resolve_hub(repo.remotes(), opts, seed=repo)
        elif not u.is_local:
            hub, _ = resolve_hub([Remote("origin", u)], opts)
        else:
            die(f"not a repository or remote URL: {target}")
    sys.stdout.write(f"{hub.path.as_posix()}\n")


def cmd_sync(hub_arg: str | None, opts: Opts) -> bool:
    hub = target_hub_from(opts.explicit_hub or hub_arg or ".")
    all_ok = True
    for b_id, rec in registered_borrowers(hub).items():
        opts.note(f"Syncing borrower {b_id}")
        ok, err = sync_borrower(hub, b_id, rec.common)
        if not ok:
            detail = f": {err}" if err else ""
            warn(
                f"sync failed for borrower {b_id} ({rec.worktree or '?'}){detail}; "
                "the hub keeps its previously synced refs"
            )
            all_ok = False
    return all_ok


def cmd_gc(gc_hub: str | None, extra_args: list[str], opts: Opts) -> None:
    target = opts.explicit_hub or gc_hub or "."
    hub = target_hub_from(target)
    if (active_pid := _active_gc_pid(hub.common)) is not None:
        die(f"active git gc (pid {active_pid}) appears to be running in {hub.path.as_posix()}; try again later")
    if not cmd_sync(target, opts):
        die(
            "not running gc: some borrowers could not be synced, so gc could prune objects "
            f"they need (fix or '{SCRIPT_NAME} forget' them)"
        )
    gc_args = ["gc"]
    if opts.quiet:
        gc_args.append("-q")
    if opts.force:
        gc_args.append("-f")
    gc_args.extend(extra_args)
    hub.git(*gc_args, capture=False, check=True, env={"GIT_BORROW_SYNCING": "1"})


def cmd_forget(target: str, opts: Opts) -> None:
    hub_spec = opts.explicit_hub
    if not hub_spec and (cand := Repo.open(target) or Repo.discover(target)):
        if h := cand.breadcrumb().get("hub"):
            hub_spec = h
    hub = target_hub_from(hub_spec or ".")

    is_archived_only = False
    if common_val := hub.local_config.get(f"borrower.{target}.common"):
        b_id, common = target, abs_path(common_val)
    elif re.fullmatch(r"[0-9a-f]{12}", target) and hub.out(
        "for-each-ref", "--count=1", "--format=x", f"{REF_NS}/{target}/"
    ):
        if opts.keep_refs:
            die(f"{target} has only archived refs; --keep-refs would leave nothing to do")
        forget_borrower_record(hub, target, keep_refs=False)
        opts.note(f"Deleted archived refs {REF_NS}/{target}/")
        return
    elif repo := Repo.open(target) or Repo.discover(target):
        b_id, common = repo.borrower_id, repo.common
        registered = hub.local_config.get(f"borrower.{b_id}.common") is not None
        has_refs = bool(hub.out("for-each-ref", "--count=1", "--format=x", f"{REF_NS}/{b_id}/"))
        if not registered and not has_refs:
            die(f"{repo.path.as_posix()} (id {b_id}) is not a registered borrower of {hub.path.as_posix()}")
        if not registered and has_refs:
            if opts.keep_refs:
                die(f"{b_id} has only archived refs; --keep-refs would leave nothing to do")
            is_archived_only = True
    else:
        die(f"not a borrower id or repository: {target}")

    if not is_archived_only and not opts.force and not opts.keep_refs:
        if (b_repo := Repo.open(common)) and b_repo.alternates_point_to(hub.objects_dir):
            die(
                f"{common.as_posix()} still borrows objects from {hub.path.as_posix()}; "
                "dropping its refs could corrupt it (use --keep-refs or --force)"
            )

    forget_borrower_record(hub, b_id, keep_refs=opts.keep_refs)
    opts.note(f"Deleted archived refs {REF_NS}/{b_id}/" if is_archived_only else f"Forgot borrower {b_id}")


def cmd_status(target: str, opts: Opts) -> None:
    if opts.global_status:
        sys.stdout.write("Global hub mappings:\n")
        mappings = all_hub_mappings()
        for canon, hub_p in mappings:
            sys.stdout.write(f"  {canon} -> {hub_p.as_posix()}\n")
        seen: list[Path] = []
        for _, hub_p in mappings:
            if any(same_path(hub_p, s) for s in seen):
                continue
            seen.append(hub_p)
            sys.stdout.write(f"\n{hub_p.as_posix()}:\n")
            if hub := Repo.open(hub_p):
                _print_hub_remotes(hub)
                _print_hub_worktrees(hub)
                _print_hub_borrowers(hub)
            else:
                sys.stdout.write("  WARNING: no longer a Git repository\n")
        return

    direct = Repo.open(target)
    repo = direct if (direct and direct.is_bare) else Repo.discover(target)
    if not repo:
        die(f"not a Git repository: {target}")

    bc = repo.breadcrumb().read()
    sys.stdout.write(f"Path: {repo.path.as_posix()}\n")

    if (common_repo := Repo.open(repo.common)) and common_repo.is_hub:
        role = "hub" if same_path(repo.path, common_repo.path) else f"worktree of hub {common_repo.path.as_posix()}"
        sys.stdout.write(f"Role: {role}\n")
        sys.stdout.write("Mapped URLs:\n")
        for canon, mapped in all_hub_mappings():
            if same_path(mapped, common_repo.path):
                sys.stdout.write(f"  {canon}\n")
        _print_hub_remotes(common_repo)
        _print_hub_worktrees(common_repo)
        _print_hub_borrowers(common_repo)
    elif h := bc.get("hub"):
        b_id = bc.get("id") or repo.borrower_id
        sys.stdout.write(
            f"Role: borrower (id {b_id})\n"
            f"  hub:      {h}\n"
            f"  linked:   {bc.get('linked') or '?'}\n"
            f"  lfs mode: {bc.get('lfs_mode') or '?'}\n"
        )
        if not (hub_repo := Repo.open(h)):
            sys.stdout.write("  WARNING: hub no longer exists\n")
        else:
            if not same_path(hub_repo.local_config.get(f"borrower.{b_id}.common"), repo.common):
                sys.stdout.write(
                    f"  WARNING: hub does not list this borrower; run {SCRIPT_NAME} link {repo.path.as_posix()}\n"
                )
            alts = repo.alternate_dirs()
            if not alts or not same_path(alts[0], hub_repo.objects_dir):
                sys.stdout.write("  WARNING: alternates do not point at the hub\n")
            _print_hub_remotes(hub_repo, borrower=repo)
    else:
        sys.stdout.write("Role: none\n")
        if mapped := next((m for rem in repo.remotes() if (m := mapped_hub(rem.url))), None):
            sys.stdout.write(f"  mapped hub: {mapped.as_posix()}\n")

    if not repo.is_bare and (repo.path / ".gitmodules").is_file():
        sys.stdout.write("Submodules:\n")
        _print_submodule_summary(repo, "  ")


# =============================================================================
# 8. CLI Parser & Dispatch
# =============================================================================

_COMMANDS = frozenset({"clone", "add", "link", "submodule", "hub", "root", "sync", "gc", "forget", "status"})
_UNSUPPORTED_SUBMODULE_CMDS = frozenset({"status", "update", "init", "sync", "foreach", "deinit", "absorbgitdirs"})


def _build_parser(cmd: str) -> argparse.ArgumentParser:
    class _Parser(argparse.ArgumentParser):
        def error(self, message: str) -> NoReturn:
            die(message)

    p = _Parser(prog=f"{SCRIPT_NAME} {cmd}", allow_abbrev=False, add_help=False)
    p.add_argument("-h", "--help", action="store_true")
    p.add_argument("-q", "--quiet", action="store_true")

    if cmd in ("clone", "add", "link", "submodule"):
        p.add_argument("--lfs", dest="lfs_mode", choices=("share", "none"), default="share")
        p.add_argument("-j", "--jobs")
        p.add_argument(
            "-r", "--recursive", "--recurse-submodules",
            dest="recursive", action=argparse.BooleanOptionalAction, default=None,
        )
    if cmd in ("clone", "link", "submodule", "hub", "root", "sync", "gc", "forget"):
        p.add_argument("--hub", "--root", dest="explicit_hub")
    if cmd in ("add", "link", "submodule", "gc", "forget"):
        p.add_argument("-f", "--force", action="store_true")
    if cmd == "forget":
        p.add_argument("--keep-refs", action="store_true")
    if cmd == "status":
        p.add_argument("-g", "--global", dest="global_status", action="store_true")
    if cmd == "clone":
        p.add_argument("-b", "--branch", dest="branch")
        p.add_argument("-B", dest="force_branch")
        p.add_argument("--detach", action="store_true")
        p.add_argument("-o", "--origin", default="origin")
    elif cmd == "submodule":
        p.add_argument("-b", "--branch", dest="branch")
        p.add_argument("--name", dest="name")
    return p


def _dispatch(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        (sys.stdout if argv else sys.stderr).write(usage() + "\n")
        return 0 if argv else 2

    cmd, rest = argv[0], argv[1:]
    if cmd not in _COMMANDS:
        die(f"unknown command: {cmd} (see --help)")

    head, tail = (rest[: rest.index("--")], rest[rest.index("--") :]) if "--" in rest else (rest, [])
    parser = _build_parser(cmd)
    if cmd in ("add", "gc"):
        ns, rem = parser.parse_known_args(head)
        args = rem + (tail if cmd == "add" else tail[1:])
    else:
        parser.add_argument("args", nargs="*")
        ns, rem = parser.parse_intermixed_args(head), []
        args = ns.args + tail[1:]

    if ns.help:
        sys.stdout.write(usage() + "\n")
        return 0

    opts = Opts(**{f: getattr(ns, f, getattr(Opts, f)) for f in Opts.__dataclass_fields__})

    if cmd == "clone":
        cmd_clone(args, opts, spec=CheckoutSpec(ns.branch, ns.force_branch, ns.detach), origin=ns.origin)
    elif cmd == "add":
        cmd_add(args, opts)
    elif cmd == "link":
        if len(args) > 1:
            die(f"usage: {SCRIPT_NAME} link [options] [-f|--force] [<path>]")
        cmd_link(args[0] if args else ".", opts)
    elif cmd == "submodule":
        if args and not tail and args[0] in _UNSUPPORTED_SUBMODULE_CMDS:
            die(f"unsupported submodule command: {args[0]} (git borrow only supports 'submodule add')")
        if args and (not tail or rest.index("add") < rest.index("--") if "add" in rest else False) and args[0] == "add":
            args = args[1:]
        cmd_submodule(args, opts, branch=ns.branch, name=ns.name)
    elif cmd in ("hub", "root"):
        if len(args) > 1:
            die(f"usage: {SCRIPT_NAME} hub [options] [<path>|<url>]")
        cmd_hub(args[0] if args else None, opts)
    elif cmd == "sync":
        if len(args) > 1:
            die(f"usage: {SCRIPT_NAME} sync [--hub <hub>] [<hub|path>]")
        return 0 if cmd_sync(args[0] if args else None, opts) else 1
    elif cmd == "gc":
        gc_hub = rem.pop(0) if rem and not rem[0].startswith("-") else None
        cmd_gc(gc_hub, rem + tail[1:], opts)
    elif cmd == "forget":
        if len(args) != 1:
            die(f"usage: {SCRIPT_NAME} forget [-f|--force] [--keep-refs] [--hub <hub>] <borrower-path|id>")
        cmd_forget(args[0], opts)
    elif cmd == "status":
        if len(args) > 1:
            die(f"usage: {SCRIPT_NAME} status [-g|--global] [<path>]")
        cmd_status(args[0] if args else ".", opts)
    return 0


def main() -> None:
    for sig_name in ("SIGINT", "SIGTERM", "SIGHUP"):
        if hasattr(signal, sig_name):
            with suppress(OSError, ValueError):
                signal.signal(getattr(signal, sig_name), lambda _s, _f: sys.exit(130))
    try:
        sys.exit(_dispatch(sys.argv[1:]))
    except BorrowError as e:
        sys.stderr.write(f"error: {e.message}\n")
        sys.exit(e.exit_code)
    except (OSError, shutil.Error) as e:
        sys.stderr.write(f"error: {e}\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
